// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model exercise {
  id            Int    @id @default(autoincrement())
  name          String @unique
  muscleGroupId Int
  sessionexercises sessionexercise[]
}

model mesocycle{
  id Int @id @default(autoincrement())
  mesoname String
  length Int
  sessions session[]
  mesocylepriority mesocyclepriority[]
}

model session{
  id Int @id @default(autoincrement())
  mesocycle mesocycle @relation(fields: [mesocycleId], references: [id])
  mesocycleId Int
  weeknumber Int
  daynumber Int
  label String?
  status String @default("pending")
  sessionexercise sessionexercise[]
  feedback feedback[]
}

model mesocyclepriority{
  id Int @id @default(autoincrement())
  checkwhichmesocycle mesocycle @relation(fields: [mesocycleId], references: [id])
  mesocycleId Int
  musclegroupid Int
  priority String
}

model sessionexercise{
  id Int @id @default(autoincrement())
  whichsession session @relation(fields: [workoutid], references: [id])
  exercise   exercise @relation(fields: [exerciseId], references: [id])
   exerciseId Int
  workoutid Int
  notes String? 
  set set[]
}

model feedback{
  id Int @id @default(autoincrement())
  whichsession session @relation(fields: [workoutid], references: [id])
  workoutid Int
  musclegroupid Int
  soreness Int
  pump Int
  workload Int
  jointpain Int
}

model set {
  id                   Int             @id @default(autoincrement())
  setNumber            Int
  weight               Float?
  reps                 Int?
  rir                  Int?
  repsTarget           Int?
  rirTarget            Int?
  status               String          @default("pending")
  sessionexerciseId    Int
  whichsessionexercise sessionexercise @relation(fields: [sessionexerciseId], references: [id])

  @@unique([sessionexerciseId, setNumber])
}